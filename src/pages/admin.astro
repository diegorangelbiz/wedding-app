---
export const prerender = false;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fffef9" />
    <title>Photo moderation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=PT+Serif:wght@400;700&display=swap"
    />
  </head>
  <body data-base={base} data-state="locked">
    <!-- Passcode -->
    <section class="gate" data-panel="locked">
      <h1>Photo moderation</h1>
      <p class="lede">Enter the passcode to manage photos.</p>
      <form id="gate-form">
        <input
          id="passcode"
          type="password"
          inputmode="text"
          autocomplete="off"
          placeholder="Passcode"
          aria-label="Passcode"
        />
        <button class="button" type="submit">Unlock</button>
      </form>
      <p class="note" id="gate-error" role="alert"></p>
    </section>

    <!-- Grid -->
    <section class="board" data-panel="unlocked">
      <header class="bar">
        <h1>Photos <span class="count" id="count"></span></h1>
        <button class="button button-quiet" type="button" id="refresh">Refresh</button>
      </header>
      <label class="dropzone" id="dropzone">
        <input id="bulk-input" type="file" accept="image/*" multiple hidden />
        <strong>Add your own photos</strong>
        <span>Choose files or drag them here. They stay in the slideshow all night.</span>
      </label>
      <p class="note" id="bulk-status" role="status" aria-live="polite"></p>

      <p class="note">
        Tap a photo to remove it. It leaves the slideshow within about a minute.
      </p>
      <div class="grid" id="grid"></div>
      <p class="note" id="empty-note" hidden>No photos yet.</p>
    </section>

    <script>
      const base = document.body.dataset.base ?? "";
      const grid = document.getElementById("grid") as HTMLDivElement;
      const countEl = document.getElementById("count") as HTMLSpanElement;
      const emptyNote = document.getElementById("empty-note") as HTMLParagraphElement;
      const gateForm = document.getElementById("gate-form") as HTMLFormElement;
      const passcodeInput = document.getElementById("passcode") as HTMLInputElement;
      const gateError = document.getElementById("gate-error") as HTMLParagraphElement;
      const dropzone = document.getElementById("dropzone") as HTMLLabelElement;
      const bulkInput = document.getElementById("bulk-input") as HTMLInputElement;
      const bulkStatus = document.getElementById("bulk-status") as HTMLParagraphElement;

      const STORE_KEY = "ad-admin-passcode";
      let passcode = sessionStorage.getItem(STORE_KEY) ?? "";

      const setState = (state: string) => {
        document.body.dataset.state = state;
      };

      // Checked server-side — a passcode compared in the browser would be
      // readable in the page source.
      async function verify(candidate: string): Promise<boolean> {
        const response = await fetch(`${base}/api/admin/delete`, {
          method: "PUT",
          headers: { "x-admin-passcode": candidate },
        });
        return response.ok;
      }

      async function load() {
        const response = await fetch(`${base}/api/photos?limit=500`, { cache: "no-store" });
        if (!response.ok) return;
        const { photos } = (await response.json()) as {
          photos: { id: string; uploadedAt: number }[];
        };

        countEl.textContent = photos.length ? `(${photos.length})` : "";
        emptyNote.hidden = photos.length > 0;
        grid.replaceChildren(...photos.map(tile));
      }

      // Same resize the capture page does, so bulk-added photos are not full
      // camera files sitting in R2 and crawling onto the venue display.
      const MAX_EDGE = 1920;
      const QUALITY = 0.82;

      async function shrink(file: File): Promise<Blob> {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(bitmap.width * scale);
        canvas.height = Math.round(bitmap.height * scale);
        canvas.getContext("2d")!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();

        const blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, "image/jpeg", QUALITY),
        );
        if (!blob) throw new Error("Could not read that photo");
        return blob;
      }

      async function bulkUpload(files: File[]) {
        const images = files.filter((file) => file.type.startsWith("image/"));
        if (!images.length) return;

        let done = 0;
        let failed = 0;
        bulkStatus.dataset.tone = "";

        // Sequential: a wedding venue's upstream does not thank you for 80
        // parallel uploads, and progress stays honest.
        for (const file of images) {
          bulkStatus.textContent = `Uploading ${done + failed + 1} of ${images.length}…`;
          try {
            const body = new FormData();
            body.append("photo", await shrink(file), "photo.jpg");
            body.append("kind", "seed");

            const response = await fetch(`${base}/api/upload`, {
              method: "POST",
              headers: { "x-admin-passcode": passcode },
              body,
            });
            if (!response.ok) throw new Error(String(response.status));
            done += 1;
          } catch {
            failed += 1;
          }
        }

        bulkStatus.textContent = failed
          ? `Added ${done}. ${failed} didn’t upload.`
          : `Added ${done} photo${done === 1 ? "" : "s"}.`;
        bulkStatus.dataset.tone = failed ? "error" : "ok";
        load();
      }

      function tile(photo: { id: string; uploadedAt: number; kind?: string }): HTMLElement {
        const figure = document.createElement("figure");
        figure.className = photo.kind === "seed" ? "tile is-seed" : "tile";

        const img = document.createElement("img");
        img.src = `${base}/api/image/${photo.id}`;
        img.alt = "";
        img.loading = "lazy";

        const time = document.createElement("figcaption");
        time.textContent =
          photo.kind === "seed"
            ? "Yours"
            : new Date(photo.uploadedAt).toLocaleTimeString([], {
                hour: "numeric",
                minute: "2-digit",
              });

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "remove";
        remove.setAttribute("aria-label", "Remove this photo");
        remove.textContent = "Remove";
        remove.addEventListener("click", () => confirmRemove(figure, photo.id));

        figure.append(img, time, remove);
        return figure;
      }

      async function confirmRemove(figure: HTMLElement, id: string) {
        if (figure.dataset.confirming === "true") return;
        figure.dataset.confirming = "true";

        const button = figure.querySelector(".remove") as HTMLButtonElement;
        const original = button.textContent;
        button.textContent = "Tap again to remove";
        button.classList.add("is-armed");

        const revert = setTimeout(() => {
          figure.dataset.confirming = "false";
          button.textContent = original;
          button.classList.remove("is-armed");
        }, 4000);

        button.addEventListener(
          "click",
          async () => {
            clearTimeout(revert);
            button.disabled = true;
            button.textContent = "Removing…";

            const response = await fetch(`${base}/api/admin/delete`, {
              method: "POST",
              headers: {
                "content-type": "application/json",
                "x-admin-passcode": passcode,
              },
              body: JSON.stringify({ id }),
            });

            if (response.ok) {
              figure.classList.add("is-gone");
              setTimeout(() => {
                figure.remove();
                const left = grid.children.length;
                countEl.textContent = left ? `(${left})` : "";
                emptyNote.hidden = left > 0;
              }, 350);
            } else {
              button.disabled = false;
              button.textContent = "Failed — try again";
            }
          },
          { once: true },
        );
      }

      gateForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        gateError.textContent = "";
        const candidate = passcodeInput.value.trim();
        if (!candidate) return;

        if (await verify(candidate)) {
          passcode = candidate;
          sessionStorage.setItem(STORE_KEY, candidate);
          setState("unlocked");
          load();
        } else {
          gateError.textContent = "That passcode didn’t work.";
        }
      });

      document.getElementById("refresh")!.addEventListener("click", load);

      bulkInput.addEventListener("change", () => {
        bulkUpload([...(bulkInput.files ?? [])]);
        bulkInput.value = "";
      });

      for (const name of ["dragenter", "dragover"]) {
        dropzone.addEventListener(name, (event) => {
          event.preventDefault();
          dropzone.classList.add("is-over");
        });
      }
      for (const name of ["dragleave", "drop"]) {
        dropzone.addEventListener(name, () => dropzone.classList.remove("is-over"));
      }
      dropzone.addEventListener("drop", (event) => {
        event.preventDefault();
        bulkUpload([...(event.dataTransfer?.files ?? [])]);
      });

      // Skip the gate if this session already unlocked.
      if (passcode) {
        verify(passcode).then((ok) => {
          if (!ok) {
            sessionStorage.removeItem(STORE_KEY);
            return;
          }
          setState("unlocked");
          load();
        });
      }
    </script>

    <style>
      :root {
        --cream: #fffef9;
        --rose: #9b6459;
        --brown: #70362b;
        --sage: #bac7af;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        padding: max(1.5rem, env(safe-area-inset-top)) 1.25rem
          max(1.5rem, env(safe-area-inset-bottom));
        background: var(--cream);
        color: var(--rose);
        font-family: "PT Serif", Georgia, serif;
        -webkit-font-smoothing: antialiased;
      }

      [data-panel] {
        display: none;
        max-width: 60rem;
        margin: 0 auto;
      }

      body[data-state="locked"] [data-panel="locked"],
      body[data-state="unlocked"] [data-panel="unlocked"] {
        display: block;
      }

      .gate {
        max-width: 22rem;
        padding-top: 20vh;
        text-align: center;
      }

      h1 {
        margin: 0;
        color: var(--brown);
        font-size: 1.75rem;
      }

      .lede {
        margin: 0.5rem 0 1.75rem;
      }

      .note {
        margin: 0.75rem 0 1.25rem;
        font-size: 0.9rem;
        opacity: 0.8;
      }

      #gate-error:not(:empty) {
        color: #b3463a;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      input {
        padding: 0.9rem 1rem;
        border: 1px solid rgba(155, 100, 89, 0.35);
        border-radius: 999px;
        background: #fff;
        color: var(--brown);
        font-family: inherit;
        font-size: 1.1rem;
        text-align: center;
      }

      input:focus-visible {
        outline: 2px solid var(--sage);
        outline-offset: 2px;
      }

      .button {
        padding: 0.9rem 1.5rem;
        min-height: 3rem;
        border: none;
        border-radius: 999px;
        background: var(--sage);
        color: var(--brown);
        font-family: inherit;
        font-size: 1.05rem;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      .button-quiet {
        background: none;
        border: 1px solid rgba(155, 100, 89, 0.35);
        color: var(--rose);
        font-size: 0.95rem;
        min-height: 2.5rem;
        padding: 0.5rem 1.1rem;
      }

      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .count {
        font-weight: 400;
        opacity: 0.7;
      }

      .dropzone {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        margin: 1.25rem 0 0;
        padding: 1.5rem 1rem;
        border: 1px dashed rgba(155, 100, 89, 0.45);
        border-radius: 1rem;
        text-align: center;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;
      }

      .dropzone.is-over {
        border-color: var(--sage);
        background: rgba(186, 199, 175, 0.18);
      }

      .dropzone strong {
        color: var(--brown);
        font-size: 1.05rem;
      }

      .dropzone span {
        font-size: 0.9rem;
        opacity: 0.8;
      }

      #bulk-status[data-tone="ok"] {
        color: #4f7a4a;
      }

      #bulk-status[data-tone="error"] {
        color: #b3463a;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
        gap: 0.85rem;
      }

      /* Tiles are built in JS, so they never receive Astro's scoping attribute —
         these rules have to be global or none of them apply. */
      :global(.tile) {
        margin: 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        transition: opacity 0.3s ease, transform 0.3s ease;
      }

      :global(.tile.is-gone) {
        opacity: 0;
        transform: scale(0.94);
      }

      :global(.tile img) {
        display: block;
        width: 100%;
        max-width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        border-radius: 0.6rem;
        background: rgba(155, 100, 89, 0.1);
      }

      :global(.tile figcaption) {
        font-size: 0.8rem;
        opacity: 0.7;
        text-align: center;
      }

      /* Your own photos, so they are obvious among the guest uploads. */
      :global(.tile.is-seed img) {
        outline: 2px solid var(--sage);
        outline-offset: 2px;
      }

      :global(.tile.is-seed figcaption) {
        color: var(--brown);
        opacity: 1;
      }

      :global(.remove) {
        padding: 0.5rem;
        border: 1px solid rgba(155, 100, 89, 0.3);
        border-radius: 999px;
        background: none;
        color: var(--rose);
        font-family: inherit;
        font-size: 0.85rem;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      /* Second tap confirms — stops a mistap deleting someone's photo. */
      :global(.remove.is-armed) {
        background: #b3463a;
        border-color: #b3463a;
        color: #fff;
      }

      :global(.remove:disabled) {
        opacity: 0.6;
      }
    </style>
  </body>
</html>
