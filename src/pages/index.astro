---
export const prerender = false;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a1614" />
    <title>Share a photo</title>
  </head>
  <body data-base={base}>
    <main>
      <header>
        <p class="eyebrow">Our wedding</p>
        <h1>Share a photo</h1>
        <p class="lede">Snap a picture and it appears on the big screen.</p>
      </header>

      <label class="capture" id="capture-label">
        <input id="photo-input" type="file" accept="image/*" capture="environment" hidden />
        <span class="capture-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.7l1.1-1.8A1 1 0 0 1 9.2 3.7h5.6a1 1 0 0 1 .9.5L16.8 6h1.7A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5z" />
            <circle cx="12" cy="12.8" r="3.6" />
          </svg>
        </span>
        <span class="capture-text">Take a photo</span>
      </label>

      <p class="status" id="status" role="status" aria-live="polite"></p>

      <div class="thumbs" id="thumbs"></div>
    </main>

    <script>
      const base = document.body.dataset.base ?? "";
      const input = document.getElementById("photo-input") as HTMLInputElement;
      const label = document.getElementById("capture-label") as HTMLLabelElement;
      const status = document.getElementById("status") as HTMLParagraphElement;
      const thumbs = document.getElementById("thumbs") as HTMLDivElement;

      const MAX_EDGE = 1920;
      const QUALITY = 0.82;

      function setStatus(message: string, tone: "" | "ok" | "error" = "") {
        status.textContent = message;
        status.dataset.tone = tone;
      }

      async function shrink(file: File): Promise<Blob> {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
        const width = Math.round(bitmap.width * scale);
        const height = Math.round(bitmap.height * scale);

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        canvas.getContext("2d")!.drawImage(bitmap, 0, 0, width, height);
        bitmap.close();

        const blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, "image/jpeg", QUALITY),
        );
        if (!blob) throw new Error("Could not process image");
        return blob;
      }

      function addThumb(blob: Blob) {
        const img = document.createElement("img");
        img.src = URL.createObjectURL(blob);
        img.onload = () => URL.revokeObjectURL(img.src);
        thumbs.prepend(img);
        while (thumbs.children.length > 6) thumbs.lastElementChild!.remove();
      }

      input.addEventListener("change", async () => {
        const file = input.files?.[0];
        if (!file) return;

        label.setAttribute("aria-busy", "true");
        setStatus("Uploading…");

        try {
          const blob = await shrink(file);
          const body = new FormData();
          body.append("photo", blob, "photo.jpg");

          const response = await fetch(`${base}/api/upload`, { method: "POST", body });
          if (!response.ok) {
            const detail = await response.json().catch(() => null);
            throw new Error(detail?.error ?? "Upload failed");
          }

          addThumb(blob);
          setStatus("Sent! It'll show up on the screen shortly.", "ok");
        } catch (error) {
          setStatus(error instanceof Error ? error.message : "Upload failed", "error");
        } finally {
          label.removeAttribute("aria-busy");
          input.value = "";
        }
      });
    </script>

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: max(1.5rem, env(safe-area-inset-top)) 1.5rem
          max(1.5rem, env(safe-area-inset-bottom));
        background: radial-gradient(circle at 50% 0%, #2c2521, #14100e 70%);
        color: #f6efe8;
        font-family: ui-rounded, "SF Pro Rounded", system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: min(28rem, 100%);
        text-align: center;
      }

      .eyebrow {
        margin: 0 0 0.5rem;
        font-size: 0.75rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #c9a227;
      }

      h1 {
        margin: 0;
        font-size: clamp(2rem, 9vw, 2.75rem);
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .lede {
        margin: 0.65rem 0 2.5rem;
        color: #b9aca2;
        font-size: 1rem;
        line-height: 1.5;
      }

      .capture {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.9rem;
        padding: 2.5rem 1.5rem;
        border: 1px solid rgba(201, 162, 39, 0.35);
        border-radius: 1.5rem;
        background: rgba(255, 255, 255, 0.04);
        cursor: pointer;
        transition:
          transform 0.15s ease,
          background 0.2s ease,
          border-color 0.2s ease;
        -webkit-tap-highlight-color: transparent;
      }

      .capture:active {
        transform: scale(0.98);
        background: rgba(255, 255, 255, 0.07);
      }

      .capture[aria-busy="true"] {
        opacity: 0.55;
        pointer-events: none;
      }

      .capture-icon svg {
        width: 3rem;
        height: 3rem;
        color: #c9a227;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .capture-text {
        font-size: 1.15rem;
        font-weight: 600;
      }

      .status {
        min-height: 1.5rem;
        margin: 1.25rem 0 0;
        font-size: 0.95rem;
        color: #b9aca2;
      }

      .status[data-tone="ok"] {
        color: #7fd48b;
      }

      .status[data-tone="error"] {
        color: #f08a7a;
      }

      .thumbs {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.5rem;
      }

      .thumbs img {
        width: 3.5rem;
        height: 3.5rem;
        object-fit: cover;
        border-radius: 0.6rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
      }
    </style>
  </body>
</html>
