---
export const prerender = false;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fffef9" />
    <title>Share a photo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=PT+Serif:wght@400;700&display=swap"
    />
  </head>
  <body data-base={base} data-state="ready">
    <main>
      <!-- Ready -->
      <section class="panel" data-panel="ready">
        <div class="panel-body">
          <h1 class="display">Share a photo</h1>
        </div>
        <div class="panel-actions">
          <label class="button" id="capture-label">
            <input id="photo-input" type="file" accept="image/*" capture="environment" hidden />
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.7l1.1-1.8A1 1 0 0 1 9.2 3.7h5.6a1 1 0 0 1 .9.5L16.8 6h1.7A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5z" />
              <circle cx="12" cy="12.8" r="3.6" />
            </svg>
            <span>Take a photo</span>
          </label>
        </div>
      </section>

      <!-- Sending -->
      <section class="panel" data-panel="sending">
        <div class="panel-body">
          <div class="spinner" aria-hidden="true"></div>
          <p class="lede">Sending…</p>
        </div>
      </section>

      <!-- Sent -->
      <section class="panel" data-panel="sent">
        <div class="panel-body">
          <svg class="tick" viewBox="0 0 52 52" fill="none" stroke="currentColor" aria-hidden="true">
            <circle cx="26" cy="26" r="24" stroke-width="1.5" opacity="0.35" />
            <path d="M15 27l8 8 15-16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h2 class="display display-sm">Thank you</h2>
        </div>
        <div class="panel-actions">
          <button class="button button-quiet" type="button" data-action="again">Take another</button>
        </div>
      </section>

      <!-- Error -->
      <section class="panel" data-panel="error">
        <div class="panel-body">
          <h2 class="display display-sm">Hmm</h2>
          <p class="lede" id="error-text">That didn’t send.</p>
        </div>
        <div class="panel-actions">
          <button class="button" type="button" data-action="again">Try again</button>
        </div>
      </section>
    </main>

    <script>
      const base = document.body.dataset.base ?? "";
      const input = document.getElementById("photo-input") as HTMLInputElement;
      const errorText = document.getElementById("error-text") as HTMLParagraphElement;

      const MAX_EDGE = 1920;
      const QUALITY = 0.82;

      const setState = (state: string) => {
        document.body.dataset.state = state;
      };

      async function shrink(file: File): Promise<Blob> {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
        const width = Math.round(bitmap.width * scale);
        const height = Math.round(bitmap.height * scale);

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        canvas.getContext("2d")!.drawImage(bitmap, 0, 0, width, height);
        bitmap.close();

        const blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, "image/jpeg", QUALITY),
        );
        if (!blob) throw new Error("Could not read that photo");
        return blob;
      }

      input.addEventListener("change", async () => {
        const file = input.files?.[0];
        if (!file) return;

        setState("sending");

        try {
          const body = new FormData();
          body.append("photo", await shrink(file), "photo.jpg");

          const response = await fetch(`${base}/api/upload`, { method: "POST", body });
          if (!response.ok) {
            const detail = await response.json().catch(() => null);
            throw new Error(detail?.error ?? "That didn’t send.");
          }

          setState("sent");
        } catch (error) {
          errorText.textContent =
            error instanceof Error ? error.message : "That didn’t send.";
          setState("error");
        } finally {
          input.value = "";
        }
      });

      for (const button of document.querySelectorAll('[data-action="again"]')) {
        button.addEventListener("click", () => setState("ready"));
      }
    </script>

    <style>
      :root {
        --cream: #fffef9;
        --rose: #9b6459;
        --brown: #70362b;
        --sage: #bac7af;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        display: flex;
        justify-content: center;
        padding: max(1.5rem, env(safe-area-inset-top)) 1.5rem
          max(1.75rem, env(safe-area-inset-bottom));
        background: var(--cream);
        color: var(--rose);
        font-family: "PT Serif", Georgia, serif;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: min(26rem, 100%);
        display: flex;
      }

      /* Two rows: content takes the free space and centres inside it, actions sit
         on the bottom edge so the button lands under a thumb on a held phone. */
      .panel {
        display: none;
        width: 100%;
        grid-template-rows: 1fr auto;
        text-align: center;
      }

      body[data-state="ready"] [data-panel="ready"],
      body[data-state="sending"] [data-panel="sending"],
      body[data-state="sent"] [data-panel="sent"],
      body[data-state="error"] [data-panel="error"] {
        display: grid;
      }

      .panel-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .panel-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .display {
        margin: 0;
        font-weight: 700;
        line-height: 1.15;
        color: var(--brown);
        font-size: clamp(2.25rem, 11vw, 3rem);
      }

      .display-sm {
        font-size: clamp(2rem, 9.5vw, 2.5rem);
      }

      .lede {
        margin: 0.75rem 0 0;
        font-size: 1.05rem;
        line-height: 1.5;
      }

      .button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        width: 100%;
        padding: 1.25rem 2rem;
        min-height: 4.5rem;
        border: none;
        border-radius: 999px;
        background: var(--sage);
        color: var(--brown);
        font-family: inherit;
        font-size: 1.5rem;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: transform 0.15s ease, filter 0.2s ease;
      }

      .button:active {
        transform: scale(0.97);
        filter: brightness(0.95);
      }

      .button svg {
        width: 1.9rem;
        height: 1.9rem;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .button-quiet {
        background: none;
        color: var(--rose);
        border: 1px solid rgba(155, 100, 89, 0.35);
      }

      .tick {
        width: 4rem;
        height: 4rem;
        margin-bottom: 1.25rem;
        color: var(--brown);
      }

      .spinner {
        width: 2.5rem;
        height: 2.5rem;
        border: 2px solid rgba(155, 100, 89, 0.2);
        border-top-color: var(--rose);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(1turn);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .spinner {
          animation-duration: 2s;
        }
        .button {
          transition: none;
        }
      }
    </style>
  </body>
</html>
