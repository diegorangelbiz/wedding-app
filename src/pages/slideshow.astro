---
export const prerender = false;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Slideshow</title>
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Corinthia:wght@400;700&family=PT+Serif:wght@400&display=swap"
    />
  </head>
  <body data-base={base}>
    <div class="stage">
      <img id="layer-a" class="layer is-active" alt="" />
      <img id="layer-b" class="layer" alt="" />
    </div>

    <!-- Fills the margins a portrait photo leaves on a landscape screen. -->
    <img class="mark mark-left" src={`${base}/logo-ad.png`} alt="" aria-hidden="true" />
    <img class="mark mark-right" src={`${base}/logo-ad.png`} alt="" aria-hidden="true" />

    <p class="empty" id="empty">Waiting for the first photo…</p>

    <button class="fullscreen" id="fullscreen" type="button" aria-label="Full screen">
      <svg class="icon-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M9 4H4v5M15 4h5v5M15 20h5v-5M9 20H4v-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <svg class="icon-collapse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M4 9h5V4M20 9h-5V4M20 15h-5v5M4 15h5v5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <script>
      const base = document.body.dataset.base ?? "";
      const layers = [
        document.getElementById("layer-a") as HTMLImageElement,
        document.getElementById("layer-b") as HTMLImageElement,
      ];
      const empty = document.getElementById("empty") as HTMLParagraphElement;

      const SLIDE_MS = 7000;
      const POLL_MS = 10000;

      let known: string[] = [];
      let seen = new Set<string>();
      let priority: string[] = [];
      let cursor = 0;
      let activeLayer = 0;
      let latestTimestamp = 0;

      const urlFor = (id: string) => `${base}/api/image/${id}`;

      function preload(id: string): Promise<HTMLImageElement> {
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.onload = () => resolve(img);
          img.onerror = reject;
          img.src = urlFor(id);
        });
      }

      // The margin beside a photo depends on its shape, so the marks are placed
      // per slide rather than at a fixed inset: object-fit: contain scales the
      // photo to the screen height, and whatever width is left over splits
      // evenly either side. Centre each mark in its half and cap its width so it
      // cannot spill onto the photo. Landscape shots leave no margin at all, so
      // the marks come off instead of sitting on top of the picture.
      let currentImage: HTMLImageElement | null = null;

      function updateMarks(img: HTMLImageElement | null = currentImage) {
        if (!img) return;
        currentImage = img;

        const { innerWidth: vw, innerHeight: vh } = window;
        const shownWidth = Math.min(vw, vh * (img.naturalWidth / img.naturalHeight));
        const margin = (vw - shownWidth) / 2;

        const root = document.documentElement;
        root.style.setProperty("--margin-centre", `${margin / 2}px`);
        root.style.setProperty("--mark-max", `${Math.max(0, margin * 0.7)}px`);

        // Below a certain margin the mark is too small to read; not worth showing.
        document.body.classList.toggle("has-side-margin", margin > 56);
      }

      window.addEventListener("resize", () => updateMarks());

      function nextId(): string | null {
        if (priority.length) return priority.shift()!;
        if (!known.length) return null;
        const id = known[cursor % known.length];
        cursor += 1;
        return id ?? null;
      }

      async function advance() {
        const id = nextId();
        if (!id) return;

        let loaded: HTMLImageElement;
        try {
          loaded = await preload(id);
        } catch {
          return;
        }

        const incoming = layers[activeLayer === 0 ? 1 : 0];
        incoming.src = urlFor(id);
        incoming.classList.add("is-active");
        layers[activeLayer].classList.remove("is-active");
        activeLayer = activeLayer === 0 ? 1 : 0;
        updateMarks(loaded);
      }

      async function poll() {
        try {
          const response = await fetch(`${base}/api/photos`, { cache: "no-store" });
          if (!response.ok) return;

          const { photos } = (await response.json()) as {
            photos: { id: string; uploadedAt: number }[];
          };
          if (!photos.length) return;

          const fresh = photos.filter((photo) => !seen.has(photo.id));
          const isFirstLoad = seen.size === 0;

          for (const photo of photos) seen.add(photo.id);
          known = photos.map((photo) => photo.id);

          // Newly uploaded photos jump the queue so guests see their shot right away.
          if (!isFirstLoad) {
            const jumpers = fresh
              .filter((photo) => photo.uploadedAt > latestTimestamp)
              .map((photo) => photo.id);
            priority.push(...jumpers);
          }

          latestTimestamp = Math.max(latestTimestamp, ...photos.map((p) => p.uploadedAt));

          if (isFirstLoad) {
            empty.hidden = true;
            advance();
          }
        } catch {
          // Network hiccup — the next poll will catch up.
        }
      }

      // Full screen. The page runs unattended for hours, so the control and the
      // cursor fade out once the room stops touching the laptop, and come back
      // on any pointer or key activity.
      const fullscreenButton = document.getElementById("fullscreen") as HTMLButtonElement;
      const IDLE_MS = 2500;
      let idleTimer: number | undefined;

      function wake() {
        document.body.classList.remove("is-idle");
        window.clearTimeout(idleTimer);
        idleTimer = window.setTimeout(
          () => document.body.classList.add("is-idle"),
          IDLE_MS,
        );
      }

      async function toggleFullscreen() {
        try {
          if (document.fullscreenElement) {
            await document.exitFullscreen();
          } else {
            await document.documentElement.requestFullscreen();
          }
        } catch {
          // Denied or unsupported (iPhone Safari has no element fullscreen) —
          // leave the page as it is rather than failing loudly at a wedding.
        }
      }

      function syncFullscreenState() {
        const active = Boolean(document.fullscreenElement);
        document.body.classList.toggle("is-fullscreen", active);
        fullscreenButton.setAttribute(
          "aria-label",
          active ? "Exit full screen" : "Full screen",
        );
        // The viewport changed, so the marks need re-measuring against it.
        updateMarks();
      }

      if (!document.documentElement.requestFullscreen) {
        fullscreenButton.hidden = true;
      }

      fullscreenButton.addEventListener("click", toggleFullscreen);
      document.addEventListener("fullscreenchange", syncFullscreenState);

      for (const name of ["pointermove", "pointerdown", "keydown"]) {
        window.addEventListener(name, wake, { passive: true });
      }

      window.addEventListener("keydown", (event) => {
        if (event.key === "f" || event.key === "F") toggleFullscreen();
      });

      wake();
      poll();
      setInterval(poll, POLL_MS);
      setInterval(advance, SLIDE_MS);
    </script>

    <style>
      body {
        margin: 0;
        height: 100dvh;
        overflow: hidden;
        /* A deep tint of the site's brown rather than black: still lets photos
           carry the room, but reads as part of the wedding palette. */
        background: #2a1512;
        color: #c9a99f;
        font-family: "PT Serif", Georgia, serif;
      }

      .stage {
        position: absolute;
        inset: 0;
      }

      .layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        transition: opacity 1.1s ease-in-out;
      }

      .layer.is-active {
        opacity: 1;
      }

      /* Sits in the letterbox margin beside a portrait photo. Rendered cream via
         filter (the source art is brown, which disappears on this ground) and
         kept faint so a landscape photo that reaches the edges is not competing
         with it. Hidden on narrow screens, where there is no side margin. */
      /* --margin-centre / --mark-max are set per slide in updateMarks(), which
         measures the gap the current photo leaves beside itself. */
      .mark {
        position: absolute;
        top: 50%;
        width: min(clamp(5rem, 11vw, 13rem), var(--mark-max, 0px));
        height: auto;
        /* Source art is brown, which sinks into this ground — render it cream. */
        filter: brightness(0) invert(1);
        opacity: 0;
        transition: opacity 0.8s ease;
        pointer-events: none;
      }

      body.has-side-margin .mark {
        opacity: 0.55;
      }

      .mark-left {
        left: var(--margin-centre, 0px);
        transform: translate(-50%, -50%);
      }

      .mark-right {
        right: var(--margin-centre, 0px);
        transform: translate(50%, -50%);
      }

      .empty {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        margin: 0;
        font-family: Corinthia, "PT Serif", cursive;
        font-size: clamp(3rem, 8vw, 5rem);
        color: #e8d5cf;
      }

      .empty[hidden] {
        display: none;
      }

      .fullscreen {
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        padding: 0;
        border: 1px solid rgba(232, 213, 207, 0.3);
        border-radius: 50%;
        background: rgba(20, 10, 8, 0.55);
        color: #e8d5cf;
        cursor: pointer;
        opacity: 0.85;
        transition: opacity 0.4s ease, background 0.2s ease;
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
      }

      .fullscreen:hover {
        background: rgba(20, 10, 8, 0.75);
      }

      .fullscreen[hidden] {
        display: none;
      }

      .fullscreen svg {
        width: 1.35rem;
        height: 1.35rem;
      }

      /* One icon at a time: expand normally, collapse once full screen. */
      .icon-collapse,
      body.is-fullscreen .icon-expand {
        display: none;
      }

      body.is-fullscreen .icon-collapse {
        display: block;
      }

      /* Nothing on screen but the photos once the room leaves it alone. */
      body.is-idle .fullscreen {
        opacity: 0;
        pointer-events: none;
      }

      body.is-idle {
        cursor: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .fullscreen {
          transition: none;
        }
      }
    </style>
  </body>
</html>
