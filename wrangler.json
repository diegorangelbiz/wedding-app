{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-app",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "wedding-app-photos"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "placeholder-replace-after-first-deploy"
    }
  ]
}